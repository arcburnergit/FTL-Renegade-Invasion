	<text>Are you sure you want to change the drone's settings?</text>
	<choice hidden="true">
		<text>Set the drone to Defence Mode.</text>
		<event>
			<text>You start calibrating the drone...</text>
			<remove name="RI_MINOR_ENGI_2_REPAIR" />
			<choice hidden="true">
				<text>Continue...</text>
				<event>
					<text>You finish calibrating the drone successfully.</text>
					<drone name="RI_MINOR_ENGI_2_DEFENCE" />
					<choice hidden="true">
						<text>Continue...</text>
						<event load="COMBAT_CHECK_TOGGLE_LOAD" />
					</choice>
				</event>
			</choice>
		</event>
	</choice>
	<choice hidden="true">
		<text>Return to the toggle menu.</text>
		<event load="COMBAT_CHECK_TOGGLE_LOAD" />
	</choice>
</event>
<event name="COMBAT_CHECK_RI_MINOR_ENGI_2_DEFENCE">
	<text>Are you sure you want to change the drone's settings?</text>
	<choice hidden="true">
		<text>Set the drone to Repair Mode.</text>
		<event>
			<text>You start calibrating the drone...</text>
			<remove name="RI_MINOR_ENGI_2_DEFENCE" />
			<choice hidden="true">
				<text>Continue...</text>
				<event>
					<text>You finish calibrating the drone successfully.</text>
					<drone name="RI_MINOR_ENGI_2_REPAIR" />
					<choice hidden="true">
						<text>Continue...</text>
						<event load="COMBAT_CHECK_TOGGLE_LOAD" />
					</choice>
				</event>
			</choice>
		</event>
	</choice>
	<choice hidden="true">
		<text>Return to the toggle menu.</text>
		<event load="COMBAT_CHECK_TOGGLE_LOAD" />
	</choice>
</event>

</FTL>